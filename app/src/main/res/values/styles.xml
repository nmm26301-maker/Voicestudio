<resources>
<style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
<item name="android:fontFamily">sans</item><item name="android:colorAccent">#8BEEFF</item><item name="android:colorControlActivated">#8BEEFF</item><item name="android:textColorPrimary">#F2F4FF</item><item name="android:textColorSecondary">#B3BFDC</item><item name="android:textColorHint">#B3BFDC</item><item name="android:colorBackground">#090E24</item><item name="android:windowBackground">#090E24</item><item name="android:statusBarColor">#090E24</item><item name="android:navigationBarColor">#090E24</item><item name="android:windowLightStatusBar">false</item><item name="android:windowLightNavigationBar">false</item><item name="android:windowActionModeOverlay">true</item><item name="android:alertDialogTheme">@style/CosmicDialogTheme</item>
</style>
<style name="CosmicDialogTheme" parent="android:style/Theme.Material.Dialog.Alert"><item name="android:textColorPrimary">#F2F4FF</item><item name="android:textColorSecondary">#B3BFDC</item><item name="android:textColorHint">#B3BFDC</item><item name="android:colorAccent">#8BEEFF</item><item name="android:colorBackground">#17213C</item><item name="android:windowBackground">@drawable/cosmic_dialog</item></style>
<style name="RecordingTheme" parent="android:style/Theme.Material.Dialog.NoActionBar"><item name="android:textColorPrimary">#F2F4FF</item><item name="android:textColorSecondary">#B3BFDC</item><item name="android:colorAccent">#8BEEFF</item><item name="android:windowBackground">@drawable/cosmic_dialog</item><item name="android:windowCloseOnTouchOutside">false</item></style>
<style name="CosmicWindowMotion"><item name="android:activityOpenEnterAnimation">@anim/cosmic_enter</item><item name="android:activityCloseEnterAnimation">@anim/cosmic_enter</item><item name="android:activityOpenExitAnimation">@anim/cosmic_hold</item><item name="android:activityCloseExitAnimation">@anim/cosmic_exit</item></style>
<style name="CosmicDialogMotion"><item name="android:windowEnterAnimation">@anim/cosmic_dialog_enter</item><item name="android:windowExitAnimation">@anim/cosmic_exit</item></style>
</resources>