<resources>
<style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
<item name="android:fontFamily">sans</item><item name="android:colorAccent">#7CEBFA</item><item name="android:colorControlActivated">#7CEBFA</item><item name="android:textColorPrimary">#EEF4FF</item><item name="android:textColorSecondary">#A7B6D1</item><item name="android:textColorHint">#A7B6D1</item><item name="android:colorBackground">#080F20</item><item name="android:windowBackground">#080F20</item><item name="android:statusBarColor">#080F20</item><item name="android:navigationBarColor">#080F20</item><item name="android:windowLightStatusBar">false</item><item name="android:windowLightNavigationBar">false</item><item name="android:windowActionModeOverlay">true</item><item name="android:alertDialogTheme">@style/CosmicDialogTheme</item>
</style>
<style name="CosmicDialogTheme" parent="android:style/Theme.Material.Dialog.Alert"><item name="android:textColorPrimary">#EEF4FF</item><item name="android:textColorSecondary">#A7B6D1</item><item name="android:textColorHint">#A7B6D1</item><item name="android:colorAccent">#7CEBFA</item><item name="android:colorBackground">#121D34</item><item name="android:windowBackground">@drawable/cosmic_dialog</item></style>
<style name="RecordingTheme" parent="android:style/Theme.Material.Dialog.NoActionBar"><item name="android:textColorPrimary">#EEF4FF</item><item name="android:textColorSecondary">#A7B6D1</item><item name="android:colorAccent">#7CEBFA</item><item name="android:windowBackground">@drawable/cosmic_dialog</item><item name="android:windowCloseOnTouchOutside">false</item></style>
<style name="CosmicWindowMotion"><item name="android:activityOpenEnterAnimation">@anim/cosmic_enter</item><item name="android:activityCloseEnterAnimation">@anim/cosmic_enter</item><item name="android:activityOpenExitAnimation">@anim/cosmic_hold</item><item name="android:activityCloseExitAnimation">@anim/cosmic_exit</item></style>
<style name="CosmicDialogMotion"><item name="android:windowEnterAnimation">@anim/cosmic_dialog_enter</item><item name="android:windowExitAnimation">@anim/cosmic_exit</item></style>
</resources>