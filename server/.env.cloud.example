# Copy to .env.cloud, enter your own values, never commit actual keys.
API_DOMAIN=voice.example.com
VOICE_GATEWAY_TOKEN=
VOICE_REFERENCE_DIR=/references
# Separate workers, each installed in its own official model environment.
VOICE_QWEN3TTS_URL=
VOICE_QWEN3TTS_TOKEN=
VOICE_COSYVOICE3_URL=
VOICE_COSYVOICE3_TOKEN=
VOICE_INDEXTTS25_URL=
VOICE_INDEXTTS25_TOKEN=
VOICE_CHATTERBOXV3_URL=
VOICE_CHATTERBOXV3_TOKEN=
# Native GPT-SoVITS must run on the bridge host loopback (api_v2.py /tts).
VOICE_GPTSOVITS_URL=
VOICE_GPTSOVITS_TOKEN=
GPT_SOVITS_NATIVE_URL=http://127.0.0.1:9880
GPT_SOVITS_SHARED_DIR=/tmp
FISH_API_KEY=
ELEVENLABS_API_KEY=
MINIMAX_API_KEY=
\nCARTESIA_API_KEY=\nCARTESIA_MODEL=sonic-3\n